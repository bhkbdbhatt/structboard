datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BoardStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum NodeType {
  DIR
  FILE
  CONFIG
  TEST
  DOC
}

model Board {
  id          String         @id @default(uuid())
  title       String
  description String?
  status      BoardStatus    @default(DRAFT)
  approvers   String[]       // List of approver user IDs/emails
  nodes       Node[]
  comments    Comment[]
  versions    BoardVersion[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Node {
  id          String     @id @default(uuid())
  boardId     String
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Node?      @relation("NodeToNode", fields: [parentId], references: [id], onDelete: Cascade)
  children    Node[]     @relation("NodeToNode")
  name        String
  type        NodeType   @default(FILE)
  description String?
  comments    Comment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Comment {
  id        String    @id @default(uuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  nodeId    String?
  node      Node?     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  author    String
  content   String
  parentId  String?
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentThread")
  createdAt DateTime  @default(now())
}

model BoardVersion {
  id            String   @id @default(uuid())
  boardId       String
  board         Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      Json     // Frozen JSON tree representation
  createdBy     String
  createdAt     DateTime @default(now())
}